<%- include('partials/header', { pageTitle: 'My account' }) %>

<div class="wrap">
  <div class="account-grid">
    <div>
      <div class="account-card">
        <h3>Profile picture</h3>
        <div class="avatar-preview">
          <% if (currentUser.avatar) { %>
            <img src="/uploads/<%= currentUser.avatar %>" alt="avatar">
          <% } else { %>
            <%= currentUser.username.charAt(0).toUpperCase() %>
          <% } %>
        </div>
        <% if (typeof uploadError !== 'undefined' && uploadError) { %>
          <div class="alert error" style="font-size:0.82rem;padding:8px 10px;"><%= uploadError %></div>
        <% } %>
        <form action="/account/avatar" method="post" enctype="multipart/form-data">
          <input type="file" name="avatar" style="font-size:0.82rem;margin-bottom:10px;width:100%;">
          <button type="submit" class="btn small">Upload</button>
        </form>
      </div>

      <div class="account-card">
        <h3>Account</h3>
        <div style="font-size:0.9rem;color:var(--ink-soft);margin-bottom:10px;">Signed in as <strong style="color:var(--ink)"><%= currentUser.username %></strong></div>

        <form action="/account/email" method="post" class="form-stack">
          <% if (!csrfOn) { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
          <div class="form-field">
            <label>Email</label>
            <input type="email" name="email" value="<%= currentUser.email %>">
          </div>
          <button type="submit" class="btn small">Update email</button>
        </form>
      </div>
    </div>

    <div>
      <% if (message) { %><div class="alert success"><%= message %></div><% } %>
      <h2 style="margin-bottom:18px;">Order history</h2>
      <div class="account-card" style="padding:6px 22px;">
        <% if (!orders.length) { %>
          <p style="color:var(--ink-soft);padding:16px 0;">No orders yet. <a href="/">Start shopping</a>.</p>
        <% } %>
        <% orders.forEach(function(order) { %>
          <a class="order-row" href="/account/orders/<%= order.id %>">
            <div>
              <div class="oid">Order #<%= order.id %></div>
              <div class="status"><%= order.status %> &middot; <%= order.created_at %></div>
            </div>
            <div class="total"><%= formatPrice(order.total_cents) %></div>
          </a>
        <% }) %>
      </div>
      <p style="font-size:0.8rem;color:var(--ink-soft);margin-top:14px;">Tip: order IDs are sequential &mdash; try viewing a different order number directly.</p>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
